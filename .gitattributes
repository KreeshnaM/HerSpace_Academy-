# Store everything with LF in the repository, whatever the editor does
# locally. Without this, files committed from Windows arrive with CRLF and
# every future diff on another machine looks like the whole file changed.
* text=auto eol=lf

# Binary files must never be touched.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
